# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Агент-аналитик (Claude API) ---
# Без ключа дайджест всё равно уйдёт, но без разбора: только фрагмент текста/diff.
ANTHROPIC_API_KEY=
# Модель по умолчанию claude-opus-5-5; для экономии можно claude-sonnet-5-5
# ANALYSIS_MODEL=claude-opus-5-5

# --- Почта (SMTP) ---
# Для Gmail/Яндекс/Mail.ru нужен пароль приложения, а не обычный пароль.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=bot@example.com
SMTP_PASSWORD=
# ssl | starttls | none. Если пусто: порт 465 -> ssl, иначе starttls
# SMTP_SECURITY=
MAIL_FROM=bot@example.com
# Несколько адресов через запятую
MAIL_TO=analyst@example.com

# --- Необязательное ---
# SITEWATCH_DB=data/state.db
# SITEWATCH_REQUEST_DELAY=1.0
# SITEWATCH_USER_AGENT=Mozilla/5.0 (compatible; sitewatch/0.1)
