# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Агент-аналитик (DeepSeek API) ---
# Ключ: platform.deepseek.com -> API keys. Не забудьте пополнить баланс.
# Без ключа дайджест всё равно уйдёт, но без разбора: только фрагмент текста/diff.
DEEPSEEK_API_KEY=
# Модель: deepseek-flash (рекомендуется, дёшево) или deepseek-v4-pro (в ~4,4 раза дороже)
# LLM_MODEL=deepseek-flash
# Режим размышлений: off (по умолчанию, дешевле) или on
# LLM_THINKING=off
# LLM_BASE_URL=https://api.deepseek.com

# --- Почта (SMTP) ---
# Для Gmail/Яндекс/Mail.ru нужен пароль приложения, а не обычный пароль.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=bot@example.com
SMTP_PASSWORD=
# ssl | starttls | none. Если пусто: порт 465 -> ssl, иначе starttls
# SMTP_SECURITY=
MAIL_FROM=bot@example.com
# Несколько адресов через запятую
MAIL_TO=analyst@example.com

# --- Необязательное ---
# SITEWATCH_DB=data/state.db
# SITEWATCH_REQUEST_DELAY=1.0
# Максимальный размер скачиваемого PDF, МБ (больше — файл пропускается)
# SITEWATCH_MAX_PDF_MB=50
# SITEWATCH_USER_AGENT=Mozilla/5.0 (compatible; sitewatch/0.1)
